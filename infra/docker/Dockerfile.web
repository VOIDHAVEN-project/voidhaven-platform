FROM node:24-alpine AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci --workspace web --include-workspace-root
COPY apps/web/ apps/web/
RUN npm run web:build

FROM nginxinc/nginx-unprivileged:1.29-alpine
ARG VOIDHAVEN_RELEASE_VERSION
ARG VOIDHAVEN_SOURCE_REVISION
ARG VOIDHAVEN_BUILD_CREATED
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
COPY infra/nginx/test-server/web-spa.conf /etc/nginx/conf.d/default.conf
LABEL org.opencontainers.image.version=$VOIDHAVEN_RELEASE_VERSION \
      org.opencontainers.image.revision=$VOIDHAVEN_SOURCE_REVISION \
      org.opencontainers.image.created=$VOIDHAVEN_BUILD_CREATED \
      org.opencontainers.image.source="voidhaven-platform/apps/web"
EXPOSE 8080
