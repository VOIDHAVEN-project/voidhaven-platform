{
  "name": "voidhaven-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run web:build",
    "contract:lint": "redocly lint --config contracts/openapi/redocly.yaml contracts/openapi/voidhaven-v0.yaml",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,md,json,html}\" \"contracts/openapi/**/*.yaml\" \"infra/**/*.{yml,yaml}\" \".github/**/*.{yml,yaml,md}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,md,json,html}\" \"contracts/openapi/**/*.yaml\" \"infra/**/*.{yml,yaml}\" \".github/**/*.{yml,yaml,md}\"",
    "lint": "npm run web:lint",
    "test": "npm run web:test",
    "verify:web": "npm run format:check && npm run lint && npm run test && npm run build && npm run contract:lint",
    "web:dev": "npm --workspace web run dev",
    "web:build": "npm --workspace web run build",
    "web:lint": "npm --workspace web run lint",
    "web:test": "npm --workspace web run test",
    "web:e2e": "npm --workspace web run test:e2e"
  },
  "engines": {
    "node": ">=24.15",
    "npm": ">=10"
  },
  "devDependencies": {
    "@redocly/cli": "2.51.1",
    "prettier": "3.6.2"
  }
}
