# 仅本地/测试示例；请不要提交真实凭据。生产值只能进入受控 Secret 管理。
VOIDHAVEN_DB_URL=jdbc:mysql://mysql:3306/voidhaven?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
VOIDHAVEN_DB_USERNAME=voidhaven_app
VOIDHAVEN_DB_PASSWORD=change-me-local-only
VOIDHAVEN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
VOIDHAVEN_BOOTSTRAP_ADMIN_LOGIN=local-admin
VOIDHAVEN_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-local-run
VOIDHAVEN_BOOTSTRAP_PARTNER_LOGIN=local-partner
VOIDHAVEN_BOOTSTRAP_PARTNER_PASSWORD=change-me-before-first-local-run
VOIDHAVEN_MEDIA_ENDPOINT=http://minio:9000
VOIDHAVEN_MEDIA_ACCESS_KEY=voidhaven-local
VOIDHAVEN_MEDIA_SECRET_KEY=change-me-local-only
VOIDHAVEN_MEDIA_BUCKET=voidhaven-media
VOIDHAVEN_MEDIA_REGION=us-east-1
VOIDHAVEN_MEDIA_FORCE_PATH_STYLE=true
VOIDHAVEN_HTTP_PORT=8080

# 本文件用于本地预览；以下测试值会让联系人和社群闭环开箱可验收，严禁用于生产。
# 候选/生产编排仍默认关闭这些能力，启用前必须注入真实密钥。
# VOIDHAVEN_PRIVATE_VALUE_KEYS 格式：keyId:base64(32字节)[,keyId:base64]
VOIDHAVEN_PRIVATE_CONTACT_ENABLED=true
VOIDHAVEN_PRIVATE_VALUE_CURRENT_KEY_ID=test-local-v1
VOIDHAVEN_PRIVATE_VALUE_KEYS=test-local-v1:dGVzdC1vbmx5LXByaXZhdGUtdmFsdWUta2V5LTMyISE=
VOIDHAVEN_COMMUNITY_GATE_ENABLED=true
VOIDHAVEN_COMMUNITY_GRANT_MINUTES=30
VOIDHAVEN_COMMUNITY_INVITE_HMAC_SECRET=test-only-community-hmac-secret-never-production
VOIDHAVEN_PUBLIC_WRITE_RATE_LIMIT=8
VOIDHAVEN_PUBLIC_WRITE_RATE_LIMIT_WINDOW_SECONDS=3600
VOIDHAVEN_PUBLIC_STATUS_QUERY_RATE_LIMIT=60
VOIDHAVEN_PUBLIC_STATUS_QUERY_RATE_LIMIT_WINDOW_SECONDS=3600
VOIDHAVEN_AUTH_LOGIN_FAILURE_LIMIT=5
VOIDHAVEN_AUTH_LOGIN_NETWORK_LIMIT=20
VOIDHAVEN_AUTH_ACTIVATION_NETWORK_LIMIT=10
VOIDHAVEN_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
