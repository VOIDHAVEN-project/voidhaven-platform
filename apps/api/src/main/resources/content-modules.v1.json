{
  "version": 1,
  "modules": [
    {
      "key": "competition",
      "label": "竞赛",
      "legacyKind": "COMPETITION",
      "active": true,
      "allowsOriginalSource": false,
      "requiresOfficialRules": true,
      "deadlinePolicy": "CLOSE_AND_ARCHIVE",
      "template": "# 竞赛要点\n\n- 适合谁：\n- 重要时间：\n- 建议准备：\n\n## 说明\n\n",
      "fields": [
        { "key": "officialRulesUrl", "label": "官方规则链接", "type": "url", "required": true, "filterable": false, "help": "必须是可核验的 HTTPS 官方规则页面。" },
        { "key": "deadlineDate", "label": "截止日期", "type": "date", "required": false, "filterable": true, "help": "仅填写来源可核验的日期。" }
      ]
    },
    {
      "key": "recruitment",
      "label": "团队招募",
      "legacyKind": "RECRUITMENT",
      "active": true,
      "allowsOriginalSource": false,
      "requiresOfficialRules": false,
      "deadlinePolicy": "CLOSE_AND_ARCHIVE",
      "template": "# 招募说明\n\n- 希望一起完成什么：\n- 适合怎样的伙伴：\n- 后续如何了解：\n\n",
      "fields": [
        { "key": "deadlineDate", "label": "截止日期", "type": "date", "required": false, "filterable": true, "help": "到期后会按平台规则关闭。" },
        { "key": "followUpUrl", "label": "后续入口", "type": "url", "required": false, "filterable": false, "help": "仅提供受控后续入口，不在站内记录沟通。" },
        { "key": "relatedCompetitionId", "label": "关联竞赛 ID", "type": "relation", "required": false, "filterable": false, "help": "如本招募围绕一项已收录竞赛。" }
      ]
    },
    {
      "key": "resource",
      "label": "学习资源",
      "legacyKind": "RESOURCE",
      "active": true,
      "allowsOriginalSource": false,
      "requiresOfficialRules": false,
      "deadlinePolicy": "NONE",
      "template": "# 资源导读\n\n## 适合谁\n\n## 如何使用\n\n",
      "fields": [
        { "key": "resourceType", "label": "资源类型", "type": "select", "required": true, "filterable": true, "options": ["GUIDE", "COURSE", "TOOL", "DOCUMENT", "ARTICLE"], "help": "用于公开筛选与展示。" },
        { "key": "audience", "label": "适用对象", "type": "text", "required": false, "filterable": true, "help": "例如：零基础、准备参赛、项目负责人。" }
      ]
    },
    {
      "key": "resource.article",
      "label": "文章 / 经验",
      "legacyKind": "RESOURCE",
      "active": true,
      "allowsOriginalSource": true,
      "requiresOfficialRules": false,
      "deadlinePolicy": "NONE",
      "template": "# 写下你的经验\n\n从一个具体问题、过程或结论开始。\n\n## 过程\n\n## 收获\n\n",
      "fields": [
        { "key": "sourceMode", "label": "来源方式", "type": "select", "required": true, "filterable": true, "options": ["ORIGINAL", "EXTERNAL"], "help": "原创文章可标注原创；引用或整理内容必须选择外部来源。" },
        { "key": "resourceType", "label": "资源类型", "type": "select", "required": true, "filterable": true, "options": ["ARTICLE"], "help": "文章首期归入学习资源。" },
        { "key": "audience", "label": "适用对象", "type": "text", "required": false, "filterable": true, "help": "例如：初学者、参赛队员。" }
      ]
    }
  ]
}
